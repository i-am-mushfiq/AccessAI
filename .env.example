####################################################################
# AccessAI — environment configuration
#
# Copy to `.env.local` and fill in. EVERY variable here has a working
# default except the AI keys, so the app runs end-to-end with zero
# configuration; the AI layer then reports itself as "Simulated".
####################################################################

# ---------------------------------------------------------------
# Database (PRD §87 DATABASE_URL)
# libSQL / SQLite file. Point at a Turso URL for a hosted database.
# ---------------------------------------------------------------
DATABASE_URL="file:./data/accessai.db"
# DATABASE_AUTH_TOKEN=""   # only for remote (Turso) libSQL

# ---------------------------------------------------------------
# Auth (PRD §87 JWT_SECRET / JWT_REFRESH_SECRET)
# MUST be replaced in any shared environment. Minimum 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------
JWT_SECRET="dev-only-access-secret-change-me-0000000000000000"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-000000000000000"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# ---------------------------------------------------------------
# AI provider — OPTIONAL.
# Leave ALL keys blank to run the deterministic engine. The UI shows a
# visible "Simulated AI" badge whenever no key is present; it is never
# silently faked.
#
# With several keys present the order is anthropic → openai → deepseek.
# Set AI_PROVIDER to choose explicitly instead of relying on that order.
# Verify whatever you set with:  npm run ai:check
# ---------------------------------------------------------------
# AI_PROVIDER="deepseek"        # anthropic | openai | deepseek | simulated

ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY="sk-..."

# Model ids. Defaults are current as of this build.
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_MODEL="gpt-4.1-mini"

# DeepSeek. Run `npm run ai:check` to list the model ids your account actually
# exposes — do not guess them. `-flash` is the right default for this workload:
# the model only rewrites a plan the deterministic layer already decided, so
# `-pro` buys reasoning depth that is never used. Swap to pro if Bangla prose
# quality matters more than latency and cost.
DEEPSEEK_MODEL="deepseek-v4-flash"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Chain of thought: disabled | adaptive | enabled. The API's own default is
# `adaptive`, which DOES think (measured: ~52-79 reasoning tokens per call, ~4x
# the output tokens, for identical answers). This product discards any trace
# unread, so it asks for `disabled` and drops one if it arrives anyway.
# `reasoning_effort: none` is NOT valid — turning it off is this setting.
DEEPSEEK_THINKING="disabled"
# Only has an effect when thinking is not disabled: low | medium | high | xhigh | max
# DEEPSEEK_REASONING_EFFORT="low"
# Escape hatch, merged last, only if the API changes:
# DEEPSEEK_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
# Embeddings are only used when OPENAI_API_KEY is set; otherwise the
# retriever falls back to BM25 + token overlap (docs/DEVIATIONS.md §3).
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------
# OTP delivery — OPTIONAL.
# With no SMS provider configured, the OTP is written to the server log
# AND surfaced in the UI as a clearly-labelled dev affordance so the
# auth flow is completable. Never enable OTP_DEV_ECHO in production.
# ---------------------------------------------------------------
OTP_DEV_ECHO="true"
# SMS_PROVIDER="ssl_wireless"     # ssl_wireless | bulksmsbd | twilio
# SMS_API_KEY=""
# SMS_SENDER_ID=""

# ---------------------------------------------------------------
# Maps (PRD §87 GOOGLE_MAPS_API_KEY) — OPTIONAL.
# Without a key, Nearby Services renders a distance-sorted list with call
# and directions actions, and states why there is no map. Fully usable;
# see docs/EXTERNAL.md.
# ---------------------------------------------------------------
NEXT_PUBLIC_MAP_PROVIDER="none"        # none | mapbox | google
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------
# Email (PRD §87 SMTP_*) — OPTIONAL.
# Unset = notifications are persisted and shown in-app only.
# ---------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="AccessAI <no-reply@accessai.gov.bd>"

# ---------------------------------------------------------------
# Object storage (PRD §87 S3_*) — OPTIONAL, and NOT YET USED.
# Document capture is not implemented in this build (docs/DEVIATIONS.md §15),
# so nothing writes to storage yet. These variables are validated and ready
# for the writer; setting them today has no effect.
# ---------------------------------------------------------------
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""    # set for Cloudflare R2

# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AccessAI"
NODE_ENV="development"

# Rate limiting (PRD §48). In-process token bucket; swap for Redis in prod.
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_AI_MAX_REQUESTS="20"
